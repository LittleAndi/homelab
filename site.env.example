# Site-specific values (ADR-0014). Copy to site.env (gitignored) and fill in.
#
# - ${KEY} placeholders in tracked config are rendered by scripts/render.sh.
# - {placeholder} in docs (shown in the comment) is the human-readable form.
# - scripts/check-site-values.sh blocks any commit that contains one of these
#   values, so every identifying string belongs here.
# Quote values with single quotes (backslashes, spaces).

# --- rendered into config ---------------------------------------------------
TAILNET='tailXXXXXX'                  # {tailnet}  ->  <host>.{tailnet}.ts.net
CRYPT_OFFSITE_REMOTE='crypt2'         # {offsite-crypt-remote}  crypt over the off-site container (ADR-0011 §3)

# --- reference only: off-site backup (ADR-0011 §3) --------------------------
AZURE_OFFSITE_ACCOUNT='storageacct'   # {offsite-azure-account}  storage account (RG pve)
AZURE_OFFSITE_CONTAINER='container'   # {offsite-azure-container}
AZURE_OFFSITE_REMOTE='azure2'         # {offsite-azure-remote}  rclone azureblob remote (container SAS)

# --- reference only (docs) ----------------------------------------------------
NC_INSTANCEID='ocXXXXXXXXXX'          # {nc-instanceid}
NC_USER='user'                        # {user}       Nextcloud + Samba account
NC_ADMIN='admin'                      # {nc-admin}   Nextcloud admin account
WORKSTATION='workstation'             # {workstation} Windows PC / WSL host
OLD_STACK_DIR='D:\path'               # {old-stack-dir}     old Podman stack
OLD_STACK_DIR_WSL='/mnt/d/path'       # {old-stack-dir-wsl}
AZURE_CONTAINER='container'           # {azure-container}  old migration container
AZURE_REMOTE='azure'                  # {azure-remote}  rclone remote (old container)
CRYPT_REMOTE='crypt'                  # {crypt-remote}  rclone crypt remote (old container)
WD_SERIAL_1='WD-XXXXXXXXXXXX'         # {wd-serial-1}
WD_SERIAL_2='WD-XXXXXXXXXXXX'         # {wd-serial-2}
HGST_SERIAL='XXXXXXXXXXXXXX'          # {hgst-serial}
SEAGATE_SERIAL='XXXXXXXX'             # {seagate-serial}

# --- local tooling --------------------------------------------------------------
LOCAL_BACKUP_DIR='/mnt/c/Users/you/Nextcloud/homelab-local'   # scripts/backup-local.sh
