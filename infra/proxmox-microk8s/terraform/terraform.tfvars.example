proxmox_endpoint  = "https://192.168.1.10:8006/"
# proxmox_api_token: not here. export TF_VAR_proxmox_api_token="terraform@pve!tf-token=…" (password manager)
proxmox_node      = "pve"
template_vmid     = 9000
boot_storage      = "local-zfs"
gateway           = "192.168.1.1"
dns_servers       = ["192.168.1.1"]
ssh_public_key    = "ssh-ed25519 AAAA... you@workstation"
